// Multi-tenant SaaS. Toda fila de negocio cuelga de tenants.id.
// Precios en guaraníes enteros (sin centavos). Instantes en timestamptz UTC.
// La jornada (staff_schedules) es hora civil, sin zona: se interpreta con tenants.timezone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppointmentStatus {
  PENDING_ACTION
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  NO_SHOW

  @@map("appointment_status")
}

enum UserRole {
  SUPERADMIN
  OWNER
  STAFF

  @@map("user_role")
}

enum CashMovementType {
  INCOME
  EXPENSE

  @@map("cash_movement_type")
}

enum CommissionStatus {
  PENDING
  PAID

  @@map("commission_status")
}

model Tenant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  slug          String   @unique
  subdomain     String   @unique
  plan          String   @default("PROFESIONAL") // BASICO, PROFESIONAL, EMPRESA
  status        String   @default("ACTIVE")      // ACTIVE, PAUSED, SUSPENDED
  /// JSON de negocio. Claves: whatsappPhone, slotStepMinutes, maxAdvanceDays,
  /// chatwootWebsiteToken (opcional, inbox del widget público), sendwoConfig, upayConfig.
  settings      Json     @default("{}")
  themeSettings Json     @default("{\"primaryColor\":\"#5b31e6\",\"backgroundColor\":\"#f4f2fb\",\"fontFamily\":\"sans\",\"logoUrl\":\"\"}") @map("theme_settings")
  timezone      String   @default("America/Asuncion")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff          Staff[]
  services       Service[]
  products       Product[]
  appointments   Appointment[]
  users          User[]
  clients        Client[]
  cashMovements      CashMovement[]
  cashRegisterCloses CashRegisterClose[]
  commissions        Commission[]
  commissionPayouts  CommissionPayout[]
  loyaltyRewards LoyaltyReward[]
  scheduleBlocks ScheduleBlock[]
  platformEvents PlatformEvent[]
  webAnalyticsSessions WebAnalyticsSession[]
  webAnalyticsEvents   WebAnalyticsEvent[]

  @@index([subdomain])
  @@map("tenants")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique
  name           String
  role           UserRole  @default(OWNER)
  tenantId       String?   @map("tenant_id") @db.Uuid
  avatarUrl      String?   @map("avatar_url")
  phone          String?
  optInMarketing Boolean   @default(false) @map("opt_in_marketing")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff          Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId        String?   @unique @map("staff_id") @db.Uuid

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model OtpCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  code      String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, code])
  @@map("otp_codes")
}

model Client {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  name       String
  phone      String
  email      String?
  notes      String?
  formula    String?
  tags       String[]      @default([])
  instagram  String?
  points     Int           @default(0)
  totalSpent Int           @default(0) @map("total_spent")
  lastVisit  DateTime?     @map("last_visit") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("clients")
}

model CashMovement {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  type          CashMovementType
  amount        Int
  category      String
  description   String
  paymentMethod String           @default("Efectivo") @map("payment_method")
  createdBy     String?          @map("created_by")
  appointmentId String?          @map("appointment_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionPayouts CommissionPayout[]

  @@index([tenantId, createdAt])
  @@index([tenantId, appointmentId])
  @@map("cash_movements")
}

model CashRegisterClose {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  openedAt     DateTime @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  openingCash  Int      @map("opening_cash")
  expectedCash Int      @map("expected_cash")
  countedCash  Int      @map("counted_cash")
  difference   Int
  notes        String?
  closedBy     String   @map("closed_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, closedAt])
  @@map("cash_register_closes")
}

model Commission {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  staffId       String           @map("staff_id") @db.Uuid
  appointmentId String?          @map("appointment_id") @db.Uuid
  amount        Int
  percentage    Int              @default(50)
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?        @map("paid_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff         Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("commissions")
}

model LoyaltyReward {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  name              String
  pointsRequired    Int      @map("points_required")
  discountGuaranies Int      @map("discount_guaranies")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("loyalty_rewards")
}

model Staff {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  name                 String
  active               Boolean  @default(true)
  commissionPercentage Int      @default(50) @map("commission_percentage")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules      StaffSchedule[]
  services       StaffService[]
  appointments   Appointment[]
  commissions    Commission[]
  commissionPayouts CommissionPayout[]
  scheduleBlocks ScheduleBlock[]
  user           User?

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("staff")
}

/// Jornada semanal. day_of_week ISO: 1 = lunes … 7 = domingo.
model StaffSchedule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek, startTime])
  @@index([staffId, dayOfWeek])
  @@map("staff_schedules")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  durationMinutes Int      @map("duration_minutes")
  price           Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff        StaffService[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

model StaffService {
  staffId   String   @map("staff_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

model Appointment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  staffId     String            @map("staff_id") @db.Uuid
  serviceId   String            @map("service_id") @db.Uuid
  clientId    String?           @map("client_id") @db.Uuid
  clientName  String            @map("client_name")
  clientPhone String            @map("client_phone")
  startTime   DateTime          @map("start_time") @db.Timestamptz(3)
  endTime     DateTime          @map("end_time") @db.Timestamptz(3)
  status      AppointmentStatus
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff       Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  commissions Commission[]

  @@index([tenantId, startTime])
  @@index([tenantId, staffId, startTime])
  @@index([tenantId, status, startTime])
  @@index([tenantId, clientId])
  @@map("appointments")
}

model Product {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  price     Int
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("products")
}

model ScheduleBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  staffId   String?  @map("staff_id") @db.Uuid
  startTime DateTime @map("start_time") @db.Timestamptz(3)
  endTime   DateTime @map("end_time") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, startTime])
  @@index([tenantId, staffId, startTime])
  @@map("schedule_blocks")
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED

  @@map("payout_status")
}

model CommissionPayout {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  staffId         String         @map("staff_id") @db.Uuid
  periodStart     DateTime       @map("period_start") @db.Timestamptz(3)
  periodEnd       DateTime       @map("period_end") @db.Timestamptz(3)
  grossCommission Int            @map("gross_commission")
  amountPaid      Int            @map("amount_paid")
  paymentMethod   String         @default("Efectivo") @map("payment_method")
  cashMovementId  String?        @map("cash_movement_id") @db.Uuid
  status          PayoutStatus   @default(PAID)
  paidAt          DateTime?      @map("paid_at") @db.Timestamptz(3)
  paidBy          String?        @map("paid_by")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff           Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cashMovement    CashMovement?  @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  items           CommissionPayoutItem[]

  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@index([tenantId, periodStart, periodEnd])
  @@map("commission_payouts")
}

model CommissionPayoutItem {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payoutId             String           @map("payout_id") @db.Uuid
  appointmentId        String           @map("appointment_id") @db.Uuid
  serviceName          String           @map("service_name")
  clientName           String           @map("client_name")
  appointmentDate      DateTime         @map("appointment_date") @db.Timestamptz(3)
  chargedAmount        Int              @map("charged_amount")
  commissionPercentage Int              @map("commission_percentage")
  commissionAmount     Int              @map("commission_amount")
  status               PayoutStatus     @default(PAID) @map("status")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  payout               CommissionPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@unique([payoutId, appointmentId])
  @@index([appointmentId])
  @@index([appointmentId, status])
  @@map("commission_payout_items")
}

model PlatformEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  event      String   // TENANT_CREATED, ONBOARDING_COMPLETED, FIRST_BOOKING, APPOINTMENT_COMPLETED, CASH_RECORDED, PAYOUT_PAID, EXPORT_CREATED, ADMIN_ACTION
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("platform_events")
}

enum WebEventType {
  CLICK
  MOUSE_MOVE
  SCROLL

  @@map("web_event_type")
}

model WebAnalyticsSession {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  sessionId      String              @map("session_id")
  pagePath       String              @map("page_path")
  deviceType     String              @default("desktop") @map("device_type")
  viewportWidth  Int                 @default(1280) @map("viewport_width")
  viewportHeight Int                 @default(800) @map("viewport_height")
  userAgent      String?             @map("user_agent")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events         WebAnalyticsEvent[]

  @@unique([tenantId, sessionId, pagePath])
  @@index([tenantId, createdAt])
  @@index([sessionId])
  @@map("web_analytics_sessions")
}

model WebAnalyticsEvent {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  sessionId       String               @map("session_id")
  sessionRecordId String?              @map("session_record_id") @db.Uuid
  eventType       WebEventType         @map("event_type")
  pagePath        String               @map("page_path")
  x               Float                @default(0)
  y               Float                @default(0)
  scrollDepth     Float                @default(0) @map("scroll_depth")
  viewportWidth   Int                  @default(1280) @map("viewport_width")
  viewportHeight  Int                  @default(800) @map("viewport_height")
  elementSelector String?              @map("element_selector")
  elementTag      String?              @map("element_tag")
  elementText     String?              @map("element_text")
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session         WebAnalyticsSession? @relation(fields: [sessionRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, pagePath])
  @@index([sessionId])
  @@map("web_analytics_events")
}



