# Conexión a Base de Datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/agendatepy"
DIRECT_URL="postgresql://usuario:password@localhost:5432/agendatepy"

# Dominio raíz para multi-tenant (ej. agendatepy.com)
AGENDATE_ROOT_DOMAIN="agendatepy.com"
NEXT_PUBLIC_ROOT_DOMAIN="agendatepy.com"
NEXT_PUBLIC_APP_URL="https://agendatepy.com"

# Google OAuth 2.0 Credentials (desde Google Cloud Console)
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# Clave secreta para firma de cookies de sesión
SESSION_SECRET="generar_clave_segura_aleatoria"

# Proveedor de Correos OTP (Opcional si se usa Google Login)
RESEND_API_KEY=""
EMAIL_FROM="AgendatePY <seguridad@agendatepy.com>"

# WhatsApp API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
